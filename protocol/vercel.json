{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash site/build.sh",
  "outputDirectory": "site/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/spec", "destination": "/spec/2026-10-04", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/schema/(.*).json",
      "headers": [
        { "key": "content-type", "value": "application/schema+json; charset=utf-8" },
        { "key": "access-control-allow-origin", "value": "*" }
      ]
    },
    {
      "source": "/schema/(.*).yaml",
      "headers": [
        { "key": "content-type", "value": "text/yaml; charset=utf-8" },
        { "key": "access-control-allow-origin", "value": "*" }
      ]
    }
  ]
}
