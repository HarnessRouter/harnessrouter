# Local data — SQLite DBs, blobs, and the secret store all live here. NEVER commit.
.hr-data/
data/
*.db
*.db-wal
*.db-shm

# Secrets / operator config
.env
.env.*
!.env.example
*.pem
*.key

node_modules/
.next/
dist/
__pycache__/
*.pyc
.DS_Store

# Never bake build context extras into the image
.git/
docs/
*.md
!README.md

# The same environment store, for the same reason: .gitignore keeps it out of a commit, but the
# build copies the working tree, so a local run's leftovers would be baked in at /app/runner/.
# Its *.md rule above saves only the two README.md; leak.txt and the two symlinks would travel.
runner/henv*/
