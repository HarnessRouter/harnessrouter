# What the vendors read your text with. Every one of them needs it: an OpenAI key, or, to have them use your
# HarnessRouter's keys instead (Bring your own key), a memory service credential (hrm_..., from
# POST /v1/memory-services) with MEMORY_BASE_URL set to your HarnessRouter's model relay, e.g.
# http://<your HarnessRouter container>:3000/api/harness/v1/llm/v1 once it is on this network.
OPENAI_API_KEY=
MEMORY_BASE_URL=https://api.openai.com/v1

# mem0 and Hindsight
POSTGRES_PASSWORD=

# mem0. Make up long random values: the first is the key you connect it with.
MEM0_ADMIN_API_KEY=
MEM0_JWT_SECRET=

# Graphiti. Optional: set it to require a key, then connect with the same one.
GRAPHITI_API_KEY=

# Optional. These are what the conformance suite ran with.
MEMORY_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
