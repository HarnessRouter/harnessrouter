# What the vendors read your text with. Every one of them needs it.
OPENAI_API_KEY=

# mem0 and Hindsight
POSTGRES_PASSWORD=

# mem0. Make up long random values: the first is the key you connect it with.
MEM0_ADMIN_API_KEY=
MEM0_JWT_SECRET=

# Graphiti. Optional: set it to require a key, then connect with the same one.
GRAPHITI_API_KEY=

# Optional. These are what the conformance suite ran with.
MEMORY_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
