# ./up.sh makes .env from this file and fills it in: you don't need to edit anything. It keeps .env at
# mode 600, because everything below is a secret.

# What each engine calls models with: a credential from your HarnessRouter (hrm_...), made by up.sh. It
# reaches only HarnessRouter's model relay (MEMORY_BASE_URL), for the engine's own two models, through
# the model keys HarnessRouter already has. HarnessRouter can withdraw it; up.sh then makes a new one.
MEM0_MODEL_KEY=
GRAPHITI_MODEL_KEY=
HINDSIGHT_MODEL_KEY=
REME_MODEL_KEY=
MEMORY_BASE_URL=

# Or a model key of your own, which then wins over the four above, with MEMORY_BASE_URL set to where it
# works, e.g. https://api.openai.com/v1.
OPENAI_API_KEY=

# The models the engines read and search with. These are what the conformance suite ran with. After a
# change, run up.sh again.
MEMORY_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Generated by up.sh. Keep them: the database keeps its first password.
POSTGRES_PASSWORD=
MEM0_ADMIN_API_KEY=
MEM0_JWT_SECRET=
GRAPHITI_API_KEY=
